# Salin berkas ini menjadi .env, lalu isi dengan pengaturanmu sendiri.
# Jangan pernah mengunggah berkas .env yang sudah diisi ke repositori.
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kasir_warung

# Akun pemilik pertama, dibuat otomatis pas server pertama kali nyala.
# Ganti kata sandinya sebelum dipakai beneran.
OWNER_USER=pemilik
OWNER_PASS=warung123
# Rahasia untuk menandai cookie sesi login. Ganti dengan teks acak yang panjang di production.
SESSION_SECRET=ganti-rahasia-ini-di-production
